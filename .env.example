# Salin ke .env.local untuk pengembangan, atau isi di Coolify → Environment Variables untuk produksi.

# --- Sumber data ---
# "mock" = data contoh fiktif (lokal), "n8n" = Data Table n8n yang dipakai bot IVANA.
DATA_SOURCE=mock

# Public API n8n. Buat API key di n8n → Settings → n8n API.
N8N_BASE_URL=https://n8n.example.com
N8N_API_KEY=
# ID Data Table (lihat URL tabel di n8n: /projects/<project>/datatables/<ID>)
N8N_TABLE_PROYEK=
N8N_TABLE_KONTAK=
N8N_TABLE_AGENDA=
N8N_TABLE_KNOWLEDGE=
# Opsional: tabel riwayat progress (buat dengan `npm run setup:n8n`).
N8N_TABLE_PROGRESS_LOG=

# --- Login OTP via WhatsApp (OpenWA) ---
OPENWA_BASE_URL=https://wa.example.com
OPENWA_API_KEY=
OPENWA_SESSION_ID=
# true = kode OTP ditampilkan di layar, tidak dikirim WA (hanya berlaku di luar produksi).
OTP_DEV_MODE=true

# --- Sesi ---
# Minimal 32 karakter acak, mis. hasil: openssl rand -base64 48
SESSION_SECRET=

# --- Hak akses ---
# Jabatan di tabel Kontak yang otomatis admin (dipisah koma, tidak peka huruf besar/kecil).
ADMIN_JABATAN=Admin,PMO
# Nomor WA tambahan yang admin (format 62xxx, dipisah koma).
ADMIN_NUMBERS=

# chat_id yang dicatat untuk agenda yang dibuat dari dashboard.
AGENDA_CHAT_ID=dashboard
